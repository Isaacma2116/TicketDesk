# --- Servidor ---
NODE_ENV=development
PORT=4000
# Orígenes permitidos (frontend). Separar con comas.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Número de proxies de confianza delante del API (0 en local, 1 detrás de Nginx).
TRUST_PROXY=0

# --- MySQL ---
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=tickets_per
DB_NAME_TEST=tickets_per_test

# --- Sesiones ---
# Secreto aleatorio (mín. 32 caracteres). Generar con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
SESSION_TTL_HOURS=8
SESSION_REMEMBER_DAYS=30
SESSION_IDLE_MINUTES=120
# true en producción (HTTPS)
COOKIE_SECURE=false

# --- Archivos subidos (logo de empresa) ---
# Directorio fuera de cualquier carpeta pública; por defecto backend/uploads
UPLOAD_DIR=
# Tamaño máximo del logo en bytes (2 MB)
LOGO_MAX_BYTES=2097152

# --- Seguridad ---
BCRYPT_ROUNDS=12
MAX_FAILED_LOGINS=5
LOCK_MINUTES=15
LOGIN_RATE_LIMIT_PER_IP=20

# --- Primer superadministrador (solo lo usa: npm run create-superadmin) ---
# Tras crearlo puedes borrar estas líneas. La contraseña deberá cambiarse en el primer acceso.
SUPERADMIN_EMAIL=admin@tuempresa.com
SUPERADMIN_FIRST_NAME=Administrador
SUPERADMIN_LAST_NAME=General
SUPERADMIN_PASSWORD=
