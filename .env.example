# Copia este archivo a .env en el servidor y rellena los valores:  cp .env.example .env
# NUNCA subas el .env a GitHub.

# Puerto por el que se accede a la app en la VM (http://IP_DE_LA_VM:8080)
APP_PORT=8080
VITE_APP_NAME=TicketDesk

# URL EXACTA con la que abres la app en el navegador (con puerto). Varias separadas por comas.
# Si no coincide, el login dará "Origen de la petición no permitido".
CORS_ORIGINS=http://192.168.1.100:8080

# false mientras uses http://. Ponlo en true solo cuando tengas HTTPS.
COOKIE_SECURE=false

# --- MySQL (contenedor db) ---
MYSQL_ROOT_PASSWORD=cambia-esto-root
DB_NAME=tickets_per
DB_USER=tickets
DB_PASSWORD=cambia-esto-app

# Mín. 32 caracteres aleatorios. Generar con:  openssl rand -base64 48
SESSION_SECRET=

# Primer superadministrador (docker compose exec backend npm run create-superadmin)
SUPERADMIN_EMAIL=admin@tuempresa.com
SUPERADMIN_FIRST_NAME=Administrador
SUPERADMIN_LAST_NAME=General
SUPERADMIN_PASSWORD=
